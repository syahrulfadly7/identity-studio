{
  "name": "traffic-ex-identity-studio",
  "version": "1.0.0",
  "description": "VIP Exclusive Proxy & User-Agent Generator & Validator Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.trafficsuite.identitystudio",
    "productName": "Identity Studio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.7.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
